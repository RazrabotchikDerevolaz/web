<?xml version="1.0"?>
<configuration>
  <!--
    Описание изменений web.config см. по адресу http://go.microsoft.com/fwlink/?LinkId=235367.

    Следующие атрибуты можно установить с помощью тега <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <compilation targetFramework="4.8" debug="false"/>   <!--debug="false" при загрузке на сервер-->
    <pages controlRenderingCompatibilityVersion="4.0"/>
  </system.web>


	<system.webServer>
		<staticContent>
			<!-- Сообщаем серверу, как правильно отдавать файлы webp браузеру -->
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
		</staticContent>
	</system.webServer>
	
	
	
</configuration>